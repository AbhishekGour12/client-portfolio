# Server Configuration
PORT=5001

# SMTP Email Configuration (Nodemailer)
# For Gmail: host = smtp.gmail.com, port = 587 (TLS) or 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com

# For Gmail, you MUST use an App Password, NOT your regular password.
# Enable 2-step verification, then generate an App Password under Security settings.
SMTP_PASS=your-app-password-here

# Recipient Address (Where contact form messages should be sent)
ADMIN_EMAIL=admin-receiver-email@gmail.com
